###############################################
CKL4 <- CreateS1000Object(matrix_path="~/data/spat_matrix/CKL4/L4_heAuto", png_path="~/data/spat_matrix/CKL4/he_roi_small.png",  spot_radius =NULL, min.cells =5,min.features = 200)
names(CKL4@assays)
SpatialFeaturePlot(CKL4, features = "nCount_Spatial",slot="counts",pt.size = 5,alpha = c(0.5, 1),crop = FALSE) + theme(legend.position = "right")
###############################################
CKL4 <- SCTransform(CKL4, assay = "Spatial",method = "glmGamPoi", verbose = F)
CKL4 <- RunPCA(CKL4, verbose = FALSE)
ElbowPlot(CKL4, ndims = 100)
CKL4 <- RunUMAP(CKL4, dims = 1:40, verbose = FALSE)
CKL4 <- FindNeighbors(CKL4, dims = 1:40, verbose = FALSE)
CKL4 <- FindClusters(CKL4, resolution = 2.5, verbose = FALSE)
DimPlot(CKL4, label = TRUE)
SpatialDimPlot( CKL4, crop=T)+
  theme(aspect.ratio = 0.9)
