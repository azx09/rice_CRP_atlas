###############################################
CKL4 <- SCTransform(CKL4, assay = "Spatial",method = "glmGamPoi", verbose = F)
CKL4 <- RunPCA(CKL4, verbose = FALSE)
ElbowPlot(CKL4, ndims = 100)
CKL4 <- RunUMAP(CKL4, dims = 1:40, verbose = FALSE)
CKL4 <- FindNeighbors(CKL4, dims = 1:40, verbose = FALSE)
CKL4 <- FindClusters(CKL4, resolution = 2.0, verbose = FALSE)
DimPlot(CKL4, label = TRUE)
SpatialDimPlot( CKL4, crop=T)+
  theme(aspect.ratio = 0.9)
