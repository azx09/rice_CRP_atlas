######################################
library(Seurat)
library(ggplot2)
library(SPOTlight)
library(SingleCellExperiment)
library(scater)
library(scran)
library(scatterpie)
######################################

# CK
CK_all_subset <- subset(CK_all, idents = c("4","6","7","9","10","11","12","20"))
sc_data <- CK_all_subset
sc_data

# 1. Convert seurat_clusters to character
sc_data$celltype <- as.character(sc_data$seurat_clusters)
# 2. Check the result
head(sc_data$celltype)

sp_data <- readRDS("path/to/spat-output/CKL4_filtered_SCT.rds")
sp_data
unique(Idents(sc_data))
unique(Idents(sp_data))
setwd("path/to/SPOTlight/output/")

# 1. Read mitochondrial and chloroplast gene lists
mt_genes <- readLines("path/to/rice_mt_genes_mini.txt")
pt_genes <- readLines("path/to/rice_pt_genes_mini.txt")

# 2. Data preparation and checks
# Ensure sc_data has celltype annotation and sp_data has correct spatial coordinates
table(sc_data$celltype)
head(sc_data@meta.data)

head(sp_data@meta.data)
names(sp_data@images)  # Confirm spatial image info

# 1. Get raw counts
counts_matrix <- GetAssayData(sc_data, assay = "RNA", slot = "counts")

# 2. Create SingleCellExperiment
sce <- SingleCellExperiment(
  assays = list(counts = counts_matrix)
)

# 3. Add cell type information
if ("celltype" %in% colnames(sc_data@meta.data)) {
  colData(sce)$celltype <- sc_data$celltype
}

# 4. Normalize
sce <- logNormCounts(sce)

# Filter mitochondrial and chloroplast genes using the provided lists.
# Ribosomal genes are also filtered using pattern matching.
ribo_genes <- grepl(pattern = "ribosomal|rps|rpl|osrp|Ribosomal",
                    x = rownames(sce), ignore.case = TRUE)

# Exact gene-name matching
is_mt_gene <- rownames(sce) %in% mt_genes
is_pt_gene <- rownames(sce) %in% pt_genes

# Exclude these genes
genes <- !(ribo_genes | is_mt_gene | is_pt_gene)

cat("Filtered out:",
    sum(ribo_genes), "ribosomal genes,",
    sum(is_mt_gene), "mitochondrial genes,",
    sum(is_pt_gene), "chloroplast genes\n")
cat("Remaining", sum(genes), "genes for analysis\n")

# Compute gene variance
dec <- modelGeneVar(sce, subset.row = genes)

# Select highly variable genes
hvg <- getTopHVGs(dec, n = 3000)

# Set cell type labels
colLabels(sce) <- colData(sce)$celltype

# Compute marker genes
mgs <- scoreMarkers(sce, subset.row = genes)

# --------------------------------------------------
# 1. Inspect the structure of mgs
# --------------------------------------------------
cat("Checking mgs structure:\n")
cat("mgs class:", class(mgs), "\n")
cat("Number of mgs elements:", length(mgs), "\n")
cat("mgs names:", names(mgs), "\n\n")

for (i in names(mgs)) {
    cat("Cell type", i, ":",
        nrow(mgs[[i]]), "rows,",
        ncol(mgs[[i]]), "columns\n")
}

cat("\nColumn names of first element:", colnames(mgs[[1]]), "\n")

# --------------------------------------------------
# 2. Filter and organize marker genes
# --------------------------------------------------
mgs_fil <- lapply(names(mgs), function(i) {
    x <- mgs[[i]]

    if (is.null(x) || nrow(x) == 0) {
        cat("Warning: mgs element for cell type", i, "is NULL or missing\n")
        return(NULL)
    }

    if (!"mean.AUC" %in% colnames(x)) {
        cat("Warning: cell type", i, "has no mean.AUC column\n")
        return(NULL)
    }

    x_fil <- x[x$mean.AUC > 0.7, ]

    if (nrow(x_fil) == 0) {
        cat("Warning: cell type", i, "has no markers after filtering (mean.AUC > 0.7)\n")
        return(NULL)
    }

    x_fil <- x_fil[order(x_fil$mean.AUC, decreasing = TRUE), ]

    x_fil$gene <- rownames(x_fil)
    x_fil$cluster <- i

    return(x_fil)
})

mgs_fil <- mgs_fil[!sapply(mgs_fil, is.null)]

if (length(mgs_fil) == 0) {
    stop("Error: markers for all cell types were filtered out. Lower the mean.AUC threshold or check the mgs data.")
}

mgs_df <- do.call(rbind, mgs_fil)

cat("\nFiltered marker gene data frame:\n")
cat("Rows:", nrow(mgs_df), "\n")
cat("Columns:", ncol(mgs_df), "\n")
cat("Cell type distribution:\n")
print(table(mgs_df$cluster))

# --------------------------------------------------
# 3. Validate data 
# --------------------------------------------------
celltype_counts <- table(mgs_df$cluster)
problematic_ct <- names(celltype_counts[celltype_counts < 2])

if (length(problematic_ct) > 0) {
    cat("\nWarning: the following cell types have fewer than 2 markers:",
        paste(problematic_ct, collapse = ", "), "\n")
    cat("Suggestion: lower the mean.AUC threshold or recompute markers\n")
}

# --------------------------------------------------
# 4. Continue with subsequent steps
# --------------------------------------------------
cat("\n=== Checking cell types in sce ===\n")
if ("celltype" %in% colnames(colData(sce))) {
  cat("sce has a celltype column\n")
  cat("Cell type distribution:\n")
  print(table(colData(sce)$celltype))
} else {
  cat("sce has no celltype column, trying to add it from sc_data...\n")
  if ("celltype" %in% colnames(sc_data@meta.data)) {
    colData(sce)$celltype <- sc_data$celltype
    cat("celltype column added\n")
  } else {
    stop("sc_data also has no celltype column; please annotate cell types first")
  }
}

colData(sce)$celltype <- as.character(colData(sce)$celltype)

# --------------------------------------------------
# 5. Match cell types
# --------------------------------------------------
available_ct_in_sce <- unique(colData(sce)$celltype)
available_ct_in_mgs <- unique(mgs_df$cluster)

cat("\nCell type matching:\n")
cat("Cell types in sce:", length(available_ct_in_sce), "\n")
cat("Cell types in mgs_df:", length(available_ct_in_mgs), "\n")
cat("Intersection:", length(intersect(available_ct_in_sce, available_ct_in_mgs)), "\n")
cat("Only in sce:", setdiff(available_ct_in_sce, available_ct_in_mgs), "\n")
cat("Only in mgs_df:", setdiff(available_ct_in_mgs, available_ct_in_sce), "\n")

common_ct <- intersect(available_ct_in_sce, available_ct_in_mgs)

if (length(common_ct) == 0) {
  stop("Error: no common cell types. Check that cell type names are consistent.")
}

cat("\nCommon cell types to be used:\n")
print(common_ct)

mgs_df <- mgs_df[mgs_df$cluster %in% common_ct, ]
sce <- sce[, colData(sce)$celltype %in% common_ct]

colData(sce)$celltype <- factor(colData(sce)$celltype, levels = common_ct)

cat("\nCell type distribution after filtering:\n")
print(table(colData(sce)$celltype))

# --------------------------------------------------
# 6. Downsample cells
# --------------------------------------------------
idx <- split(seq(ncol(sce)), colData(sce)$celltype)

n_cells <- 100
cat("\nDownsampling: at most", n_cells, "cells per cell type\n")

cs_keep <- lapply(idx, function(i) {
    n <- length(i)
    if (n <= n_cells) {
        return(i)
    } else {
        return(sample(i, n_cells))
    }
})

cells_to_keep <- unlist(cs_keep)
sce_subset <- sce[, cells_to_keep]

cat("\nsce after downsampling:\n")
cat("Total cells:", ncol(sce_subset), "\n")
cat("Genes:", nrow(sce_subset), "\n")
cat("Cell type distribution:\n")
print(table(colData(sce_subset)$celltype))

# --------------------------------------------------
# 7. Prepare spatial data
# --------------------------------------------------
cat("\n=== Preparing spatial data ===\n")
cat("Spatial data object class:", class(sp_data), "\n")
cat("Spatial data assays:", names(sp_data@assays), "\n")

if ("SCT" %in% names(sp_data@assays)) {
  DefaultAssay(sp_data) <- "SCT"
  spatial_matrix <- GetAssayData(sp_data, assay = "SCT", slot = "data")
  cat("Using SCT assay data slot\n")
} else if ("RNA" %in% names(sp_data@assays)) {
  DefaultAssay(sp_data) <- "RNA"
  spatial_matrix <- GetAssayData(sp_data, assay = "RNA", slot = "data")
  cat("Using RNA assay data slot\n")
} else {
  stop("Spatial data has neither SCT nor RNA assay")
}

cat("Spatial matrix dimensions:", dim(spatial_matrix), "\n")

# --------------------------------------------------
# 8. Ensure gene names match
# --------------------------------------------------
common_genes <- intersect(rownames(sce_subset), rownames(spatial_matrix))
cat("\nCommon genes:", length(common_genes), "\n")

if (length(common_genes) < 1000) {
  warning("Few common genes; deconvolution accuracy may be affected")

  if (exists("hvg")) {
    hvg_missing <- setdiff(hvg, common_genes)
    cat("HVGs missing:", length(hvg_missing), "\n")
    if (length(hvg_missing) > 0) {
      cat("First 10 missing HVGs:", head(hvg_missing, 10), "\n")
    }
  }
}

spatial_matrix <- spatial_matrix[common_genes, ]
sce_filtered <- sce_subset[common_genes, ]

mgs_df <- mgs_df[mgs_df$gene %in% common_genes, ]

cat("\nData after filtering:\n")
cat("Spatial matrix dimensions:", dim(spatial_matrix), "\n")
cat("sce_filtered dimensions:", dim(sce_filtered), "\n")
cat("mgs_df rows:", nrow(mgs_df), "\n")
cat("Cell type distribution in mgs_df:\n")
print(table(mgs_df$cluster))

# --------------------------------------------------
# 9. Check HVGs
# --------------------------------------------------
cat("\n=== Checking HVGs ===\n")

if (!exists("hvg")) {
  cat("hvg is not defined; computing HVGs from sce_filtered...\n")

  genes_to_keep <- !grepl("^RP[LS]|^MT-|^Rp[l|s]|Mt", rownames(sce_filtered), ignore.case = TRUE)

  dec <- modelGeneVar(sce_filtered, subset.row = genes_to_keep)
  hvg <- getTopHVGs(dec, n = 3000)

  cat("Computed HVGs:", length(hvg), "\n")
} else {
  cat("Using predefined hvg, length:", length(hvg), "\n")
}

hvg <- intersect(hvg, common_genes)
cat("HVGs after filtering (in common genes):", length(hvg), "\n")

if (length(hvg) < 500) {
  warning("Too few HVGs; check data quality")
}

# --------------------------------------------------
# 10. Run SPOTlight deconvolution
# --------------------------------------------------
cat("\n=== Running SPOTlight deconvolution ===\n")

cat("Checking parameters:\n")
cat("sce_filtered dimensions:", dim(sce_filtered), "\n")
cat("spatial_matrix dimensions:", dim(spatial_matrix), "\n")
cat("groups length:", length(colData(sce_filtered)$celltype), "\n")
cat("mgs_df rows:", nrow(mgs_df), "\n")
cat("hvg length:", length(hvg), "\n")

if (!is.matrix(spatial_matrix)) {
  spatial_matrix <- as.matrix(spatial_matrix)
}

set.seed(123)
tryCatch({
  res <- SPOTlight(
    x = sce_filtered,
    y = spatial_matrix,
    groups = as.character(colData(sce_filtered)$celltype),
    mgs = as.data.frame(mgs_df),
    hvg = hvg[1:min(3000, length(hvg))],
    weight_id = "mean.AUC",
    group_id = "cluster",
    gene_id = "gene",
    verbose = TRUE,
    min_prop = 0.01
  )

  cat("\nSPOTlight deconvolution succeeded!\n")

  mat <- res$mat
  mod <- res$NMF

  cat("Deconvolution matrix dimensions:", dim(mat), "\n")
  cat("Cell type proportions for the first 3 spots:\n")
  print(head(mat)[, 1:min(3, ncol(mat))])

  # --------------------------------------------------
  # 11. Visualization
  # --------------------------------------------------
  cat("\nGenerating visualizations...\n")

  par(mfrow = c(2, 1))

  p1 <- plotTopicProfiles(
    x = mod,
    y = colData(sce_filtered)$celltype,
    facet = FALSE,
    min_prop = 0.01,
    ncol = 1
  ) +
    theme(aspect.ratio = 1) +
    ggtitle("Topic Profiles (Non-faceted)")

  p2 <- plotTopicProfiles(
    x = mod,
    y = colData(sce_filtered)$celltype,
    facet = TRUE,
    min_prop = 0.01,
    ncol = min(6, length(unique(colData(sce_filtered)$celltype)))
  ) +
    ggtitle("Topic Profiles (Faceted by Cell Type)")

  print(p1)
  print(p2)

  # --------------------------------------------------
  # 12. Save results into the spatial data object
  # --------------------------------------------------
  cat("\nAdding results to the spatial data object...\n")

  prop_df <- as.data.frame(t(mat))
  colnames(prop_df) <- paste0(colnames(prop_df), "_prop")

  spot_names <- colnames(sp_data)
  common_spots <- intersect(spot_names, rownames(prop_df))

  if (length(common_spots) > 0) {
    prop_df <- prop_df[common_spots, ]
    sp_data@meta.data <- cbind(sp_data@meta.data, prop_df)

    sp_data$dominant_celltype <- colnames(mat)[apply(mat[common_spots, ], 1, which.max)]

    cat("Results successfully added to sp_data\n")
    cat("New metadata columns:\n")
    new_cols <- grep("_prop$|dominant_celltype", colnames(sp_data@meta.data), value = TRUE)
    print(head(new_cols))
  } else {
    warning("Spot names do not match; cannot add results to sp_data automatically")
  }

  # --------------------------------------------------
  # 13. Save results
  # --------------------------------------------------
  saveRDS(res, "spotlight_results.rds")
  saveRDS(sp_data, "spatial_with_deconvolution.rds")
  write.csv(mat, "celltype_proportions.csv")

  summary_stats <- data.frame(
    CellType = colnames(mat),
    MeanProportion = colMeans(mat),
    MaxProportion = apply(mat, 2, max),
    SpotsDetected = colSums(mat > 0.05)
  )

  cat("\nCell type proportion summary:\n")
  print(summary_stats)
  write.csv(summary_stats, "deconvolution_summary.csv")

  cat("\n=== Analysis complete! ===\n")
  cat("Results saved to the following files:\n")
  cat("1. spotlight_results.rds - full SPOTlight result\n")
  cat("2. spatial_with_deconvolution.rds - spatial data with deconvolution results\n")
  cat("3. celltype_proportions.csv - cell type proportion matrix\n")
  cat("4. deconvolution_summary.csv - deconvolution summary\n")

}, error = function(e) {
  cat("\nSPOTlight analysis failed:", e$message, "\n")

  cat("\nRetrying with simplified settings...\n")

  res_simple <- SPOTlight(
    x = sce_filtered,
    y = spatial_matrix,
    groups = as.character(colData(sce_filtered)$celltype),
    mgs = mgs_df,
    hvg = hvg[1:min(1000, length(hvg))],
    weight_id = "mean.AUC",
    group_id = "cluster",
    gene_id = "gene",
    verbose = TRUE
  )

  cat("Simplified run succeeded!\n")

  saveRDS(res_simple, "spotlight_results_simple.rds")

  mat_simple <- res_simple$mat
  write.csv(mat_simple, "celltype_proportions_simple.csv")

  cat("Simplified results saved\n")
})

# --------------------------------------------------
# Extract NMF feature matrix
# --------------------------------------------------
cat("\n=== Extracting NMF feature matrix ===\n")

if (!exists("res")) {
  stop("Error: res does not exist. Run SPOTlight first.")
}

if ("mat" %in% names(res)) {
  mat <- res$mat
  mod <- res$NMF

  cell_types <- colnames(mat)
  cat("Cell types from deconvolution matrix, count:", length(cell_types), "\n")
  cat("Cell types:", paste(cell_types, collapse = ", "), "\n")
} else {
  stop("Error: res has no mat element")
}

cat("\nChecking NMF model structure:\n")
cat("NMF model class:", class(mod), "\n")

if (inherits(mod, "NMFfit")) {
  cat("NMFfit detected; extracting feature matrix with NMF::basis()...\n")

  if (!requireNamespace("NMF", quietly = TRUE)) {
    install.packages("NMF")
  }
  library(NMF)

  signature_matrix <- NMF::basis(mod)
  cat("Feature matrix extracted, dimensions:", dim(signature_matrix), "\n")

} else {
  if ("w" %in% names(mod)) {
    signature_matrix <- mod$w
    cat("Feature matrix from mod$w, dimensions:", dim(signature_matrix), "\n")
  } else if ("basis" %in% names(mod)) {
    signature_matrix <- mod$basis
    cat("Feature matrix from mod$basis, dimensions:", dim(signature_matrix), "\n")
  } else if ("W" %in% names(mod)) {
    signature_matrix <- mod$W
    cat("Feature matrix from mod$W, dimensions:", dim(signature_matrix), "\n")
  } else {
    stop("Unrecognized NMF model structure")
  }
}

cat("\nAdding row and column names to the feature matrix...\n")

if (exists("sce_filtered")) {
  all_genes <- rownames(sce_filtered)
  cat("Genes from sce_filtered, count:", length(all_genes), "\n")

  if (nrow(signature_matrix) <= length(all_genes)) {
    rownames(signature_matrix) <- all_genes[1:nrow(signature_matrix)]
    cat("Using first", nrow(signature_matrix), "genes as row names\n")
  } else {
    rownames(signature_matrix) <- paste0("Gene_", 1:nrow(signature_matrix))
    cat("Warning: feature matrix has more rows than available genes; using placeholders\n")
  }
} else {
  if (exists("sp_data")) {
    spatial_genes <- rownames(sp_data)
    if (nrow(signature_matrix) <= length(spatial_genes)) {
      rownames(signature_matrix) <- spatial_genes[1:nrow(signature_matrix)]
      cat("Using first", nrow(signature_matrix), "spatial genes as row names\n")
    } else {
      rownames(signature_matrix) <- paste0("Gene_", 1:nrow(signature_matrix))
      cat("Using placeholder gene names\n")
    }
  } else {
    rownames(signature_matrix) <- paste0("Gene_", 1:nrow(signature_matrix))
    cat("Using placeholder gene names\n")
  }
}

if (ncol(signature_matrix) == length(cell_types)) {
  colnames(signature_matrix) <- cell_types
  cat("Cell type column names set successfully\n")
} else {
  colnames(signature_matrix) <- paste0("Topic_", 1:ncol(signature_matrix))
  cat("Warning: feature matrix columns do not match number of cell types; using Topic names\n")
}

write.csv(signature_matrix, "spotlight_signature_matrix.csv")
cat("Feature matrix saved to: spotlight_signature_matrix.csv\n")

cat("\nFirst 5 rows and 5 columns of feature matrix:\n")
print(signature_matrix[1:min(5, nrow(signature_matrix)),
                       1:min(5, ncol(signature_matrix))])

# ============================================================================
# SPOTlight core result visualization: spatial distribution maps
# ============================================================================

cat("\n=== Plotting core spatial distribution maps ===\n")

# 1. Add deconvolution results to the Seurat object
cat("1. Integrating cell type proportions into spatial Seurat object...\n")
decon_mtrx <- res$mat
cell_types <- colnames(decon_mtrx)
common_spots <- intersect(rownames(decon_mtrx), colnames(sp_data))

if (length(common_spots) == nrow(decon_mtrx) && length(common_spots) == ncol(sp_data)) {
  for (ct in cell_types) {
    sp_data[[paste0("SPOTlight_", ct)]] <- decon_mtrx[common_spots, ct]
  }
  cat("   Created metadata columns for", length(cell_types), "cell types (e.g., SPOTlight_1).\n")

  sp_data$dominant_celltype <- colnames(decon_mtrx)[apply(decon_mtrx, 1, which.max)]
  cat("   Added 'dominant_celltype' column indicating dominant cell type per spot.\n")
} else {
  stop("Error: spot count or names do not match. Check data alignment.")
}

# 2. Individual spatial distribution maps per cell type
cat("\n2. Generating spatial distribution maps (Seurat SpatialFeaturePlot)...\n")

image_name <- "CK4"
cat("   Using image name:", image_name, "\n")

pdf("all_celltype_spatial_distributions-CK.pdf", width = 10, height = 8)
for (ct in cell_types) {
  feature_name <- paste0("SPOTlight_", ct)
  cat("   Plotting:", ct, "->", feature_name, "\n")

  p <- SpatialFeaturePlot(
    object = sp_data,
    features = feature_name,
    images = image_name,
    pt.size.factor = 6,
    crop = TRUE,
    alpha = c(0.8, 1)
  ) +
  theme(aspect.ratio = 0.9) +
    scale_fill_gradientn(
      colors = c("grey90", "red", "darkred"),
      name = "Proportion"
    ) +
    ggtitle(paste("Spatial Distribution - Cell Type", ct))

  print(p)
}
dev.off()
cat("   All cell type distribution plots saved to: all_celltype_spatial_distributions-CK.pdf\n")

# 3. Optional: spatial pie chart using scatterpie
cat("\n3. Attempting spatial pie chart (scatterpie)...\n")
if (requireNamespace("scatterpie", quietly = TRUE)) {
  coords <- GetTissueCoordinates(sp_data, image = image_name)
  plot_data <- cbind(coords[common_spots, ], decon_mtrx[common_spots, cell_types])

  library(RColorBrewer)
  my_pal <- colorRampPalette(brewer.pal(9, "Set1"))(length(cell_types))

  p_pie <- ggplot() +
    geom_scatterpie(
      data = plot_data,
      aes(x = imagecol, y = imagerow),
      cols = cell_types,
      color = NA,
      pie_scale = 0.4,
      alpha = 0.8
    ) +
    scale_fill_manual(values = my_pal) +
    coord_fixed() +
    labs(title = "Spatial Scatterpie of Cell Type Proportions (CK)") +
    theme_void() +
    theme(legend.position = "right")

  # p_pie <- p_pie + scale_y_reverse()

  ggsave("CK_spatial_scatterpie.pdf", plot = p_pie, width = 12, height = 9)
  cat("   Spatial pie chart saved to: CK_spatial_scatterpie.pdf\n")
} else {
  cat("   'scatterpie' not installed; skipping pie chart. Install with install.packages('scatterpie').\n")
}

# 4. Save final results
cat("\n4. Saving final Seurat object with deconvolution results...\n")
saveRDS(sp_data, file = "sp_data_CK_with_spotlight_final.rds")
write.csv(decon_mtrx, file = "CK_spotlight_cell_type_proportions_final.csv")
cat("   Final object saved: sp_data_CK_with_spotlight_final.rds\n")
cat("   Proportion matrix saved: CK_spotlight_cell_type_proportions_final.csv\n")

cat("\n", paste(rep("=", 60), collapse = ""), "\n", sep = "")
cat("Core spatial visualization complete! Check the generated PDF files.\n")
cat(paste(rep("=", 60), collapse = ""), "\n", sep = "")
